// Catalogue de produits commerciaux C4A (campagne C4 « Compléments clean
// label », LOT-01, décision praticien du 2026-07-24 : catalogue
// DGCCRF/Compl'Alim complet importé en brouillons). Référentiel documentaire,
// aucune donnée patient. Le produit est une matérialisation commerciale qui se
// projette sur le pivot clinique SupplementIngredient via sa composition ; les
// règles, seuils et alertes restent au niveau ingrédient (V1 intacte).
// Reformulation = nouvelle ligne (version_formulation), jamais d'édition en
// place (append-only garanti par l'application, pas par la base — même posture
// que clinical_rules.version_regle). L'import de masse ne pose jamais
// statut_fiche = 'verifiee' (décision n°11 : une source externe produit des
// brouillons, la vérification est un geste praticien signé).

model SupplementProduct {
  id                       String    @id @default(cuid())
  nomCommercial            String    @map("nom_commercial")
  marque                   String    @map("marque")
  marche                   String    @default("FR") @map("marche")
  versionFormulation       Int       @default(1) @map("version_formulation")
  sourceProvenance         String    @map("source_provenance")
  sourceIdentifiant        String    @map("source_identifiant")
  sourceUrl                String?   @map("source_url")
  dateDerniereVerification DateTime? @map("date_derniere_verification")
  statutFiche              String    @default("importee") @map("statut_fiche")
  niveauCompletude         String    @map("niveau_completude")
  contenuSha256            String?   @map("contenu_sha256")
  donneesManquantes        String[]  @default([]) @map("donnees_manquantes")
  incertitudes             String?   @map("incertitudes")
  // Nombre de lignes ACTIVES déclarées par la source. NULL = on ne sait pas
  // (fail-closed : `integre` reste hors d'atteinte) ; 0 = la source ne déclare
  // aucun actif, ce qui est une information et non une ignorance.
  compositionSourceLignes  Int?      @map("composition_source_lignes")
  labels                   String[]  @default([]) @map("labels")
  allergenes               String[]  @default([]) @map("allergenes")
  excipients               String[]  @default([]) @map("excipients")
  verifiePar               String?   @map("verifie_par")
  verifieLe                DateTime? @map("verifie_le")
  actif                    Boolean   @default(true) @map("actif")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  compositions    SupplementProductComposition[]
  versionCourante SupplementProductVersionCourante?

  @@unique([sourceProvenance, sourceIdentifiant, versionFormulation], map: "supplement_products_source_version_key")
  @@index([marque, nomCommercial], map: "supplement_products_marque_nom_idx")
  @@index([statutFiche, actif], map: "supplement_products_statut_idx")
  @@map("supplement_products")
}

model SupplementProductComposition {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  ingredientId   String   @map("ingredient_id")
  formeId        String?  @map("forme_id")
  // `doseParDjr`, et non « par portion » : la source déclare une quantité par
  // DOSE JOURNALIÈRE RECOMMANDÉE. Les deux grandeurs diffèrent d'un facteur
  // égal au nombre de prises — voir 20260731200000_c4_composition_dose.
  doseParDjr     Float?   @map("dose_par_djr")
  unite          String?  @map("unite")
  position       Int      @default(0) @map("position")
  createdAt      DateTime @default(now()) @map("created_at")

  product    SupplementProduct          @relation(fields: [productId], references: [id])
  ingredient SupplementIngredient       @relation(fields: [ingredientId], references: [id])
  // onDelete: Restrict explicite — SANS lui, une relation optionnelle défaute à
  // SET NULL côté Prisma, alors que la migration crée la FK en RESTRICT :
  // dérive détectée par le banc B-1. Les deux FK requises (product, ingredient)
  // défautent déjà à RESTRICT, d'où leur absence ici.
  forme      SupplementIngredientForme? @relation(fields: [formeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([productId, ingredientId, formeId], map: "supplement_product_compositions_produit_ingredient_forme_key")
  @@index([ingredientId], map: "supplement_product_compositions_ingredient_idx")
  @@map("supplement_product_compositions")
}

model SupplementProductVersionCourante {
  id                String   @id @default(cuid())
  sourceProvenance  String   @map("source_provenance")
  sourceIdentifiant String   @map("source_identifiant")
  productId         String   @unique @map("product_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product SupplementProduct @relation(fields: [productId], references: [id])

  @@unique([sourceProvenance, sourceIdentifiant], map: "supplement_product_versions_courantes_source_key")
  @@map("supplement_product_versions_courantes")
}

// ─── TRUST V1 (campagne 2026-07-15-trust-information-patient-droits-v1) ─────
// Traçabilité du cadre d'information patient (migration trust_v1, confirmée
// explicitement par l'utilisateur le 2026-07-16). Tables ADDITIVES et
// append-only : les événements (accusés, choix) ne sont jamais modifiés ni
// supprimés ; seuls les statuts de traitement praticien des signalements
// évoluent.

// Accusé de lecture d'une version de document d'information — « j'ai pris
// connaissance », distinct de toute autorisation. La version et son hash
// (lib/trust/contenus/registre.ts) prouvent quel texte a été présenté.
model TrustAcknowledgement {
  id              String   @id @default(cuid())
  idPatient       String   @map("id_patient")
  documentKey     String   @map("document_key")
  documentVersion String   @map("document_version")
  contentHash     String   @map("content_hash")
  type            String   @map("type") // presente | pris_connaissance
  canal           String   @default("portail") @map("canal")
  acteurRole      String   @default("patient") @map("acteur_role")
  createdAt       DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@unique([idPatient, documentKey, documentVersion, type], map: "trust_ack_patient_doc_version_type_key")
  @@map("trust_acknowledgements")
}

// Événement de choix facultatif — append-only : un retrait n'écrase jamais
// l'accord précédent, il le supplante (supersedesEventId).
model TrustChoiceEvent {
  id                String   @id @default(cuid())
  idPatient         String   @map("id_patient")
  finalite          String   @map("finalite") // partage_medecin_traitant | communications_non_essentielles
  statut            String   @map("statut") // accorde | refuse | retire
  documentVersion   String   @map("document_version")
  supersedesEventId String?  @map("supersedes_event_id")
  acteurRole        String   @default("patient") @map("acteur_role")
  enregistreLe      DateTime @default(now()) @map("enregistre_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, finalite], map: "trust_choice_patient_finalite_idx")
  @@map("trust_choice_events")
}

// Signalement d'effet indésirable suspecté — tel que déclaré par le patient,
// sans déduction de causalité. L'orientation est produite par la règle
// déterministe versionnée (lib/trust/securite.ts) et tracée avec sa version.
model TrustAdverseEffectReport {
  id                   String    @id @default(cuid())
  idPatient            String    @map("id_patient")
  produitLibelle       String    @map("produit_libelle")
  doseDeclaree         String?   @map("dose_declaree")
  debutPrise           String?   @map("debut_prise")
  symptomes            String    @map("symptomes")
  debutSymptomes       String?   @map("debut_symptomes")
  produitsConcomitants String?   @map("produits_concomitants")
  actionPrise          String    @default("ne_sait_pas") @map("action_prise") // aucune | reduit | arrete | ne_sait_pas
  severiteDeclaree     String    @map("severite_declaree") // legere | moderee | severe | incertaine
  orientation          String    @map("orientation")
  regleId              String    @map("regle_id")
  regleVersion         String    @map("regle_version")
  statutTraitement     String    @default("recu") @map("statut_traitement") // recu | en_cours | traite | clos
  examineLe            DateTime? @map("examine_le")
  soumisLe             DateTime  @default(now()) @map("soumis_le")

  // ASSOCIATION À UNE INTERVENTION — D-101, LOT-05 (DC-42).
  //
  // `DC-42` exige un symptôme « temporellement associé à une intervention ».
  // Aucune des colonnes ci-dessus ne portait cette association : `produitLibelle`
  // est du texte libre saisi par le patient, `debutPrise` et `debutSymptomes`
  // sont des chaînes de 100 caractères qu'aucun format ne contraint. La règle
  // était donc inapplicable, non par choix mais par absence de donnée.
  //
  // Les trois colonnes sont NULLABLES et s'AJOUTENT : les deux chaînes libres
  // restent, avec les signalements déjà enregistrés. Un signalement antérieur
  // porte donc `null` partout ici — et `null` se lit « association inconnue »,
  // jamais « aucune association » (DC-24).
  protocolDraftId      String?   @map("protocol_draft_id")
  debutPriseLe         DateTime? @map("debut_prise_le")
  debutSymptomesLe     DateTime? @map("debut_symptomes_le")

  patient       Patient        @relation(fields: [idPatient], references: [idPatient])
  protocolDraft ProtocolDraft? @relation(fields: [protocolDraftId], references: [id])

  @@index([statutTraitement], map: "trust_aer_statut_idx")
  @@index([idPatient, statutTraitement], map: "trust_aer_patient_statut_idx")
  @@map("trust_adverse_effect_reports")
}

// Incident de confidentialité signalé par le patient.
model TrustPrivacyIncident {
  id               String    @id @default(cuid())
  idPatient        String    @map("id_patient")
  categorie        String    @map("categorie")
  description      String    @map("description")
  statutTraitement String    @default("recu") @map("statut_traitement")
  examineLe        DateTime? @map("examine_le")
  soumisLe         DateTime  @default(now()) @map("soumis_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([statutTraitement], map: "trust_incident_statut_idx")
  @@map("trust_privacy_incidents")
}

// Demande d'exercice de droits — l'interface ne promet jamais un droit
// absolu ; chaque demande reçoit une réponse expliquant ce qui est possible.
model TrustRightsRequest {
  id               String    @id @default(cuid())
  idPatient        String    @map("id_patient")
  type             String    @map("type") // acces | rectification | effacement | limitation | opposition | portabilite | retrait_choix | information
  description      String?   @map("description")
  statutTraitement String    @default("recu") @map("statut_traitement")
  reponse          String?   @map("reponse")
  examineLe        DateTime? @map("examine_le")
  soumisLe         DateTime  @default(now()) @map("soumis_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([statutTraitement], map: "trust_droits_statut_idx")
  @@map("trust_rights_requests")
}

// ─── C2A PERSISTANCE V1 (campagne 2026-07-11-suivi-j7-j14-j21-et-persistance) ─
// Persistance minimale du suivi 21 jours (migration c2a_persistance_v1, spec
// SPEC_LOT-01_MODELE_PERSISTANCE.md §8, gate confirmé par l'utilisateur le
// 2026-07-17). Tables ADDITIVES. Snapshot/review/decision-card NON persistés
// (recalculables) ; provenance ancrée par hashes. Corrections append-only.

// Épisode d'évaluation CONFIRMÉ par le praticien (les propositions restent en
// mémoire). PK = assessmentEpisodeId du contrat C1 (provenance + idempotence).
// Pas d'input_hash moteur : l'épisode est une sélection, pas une preuve hashée.
model AssessmentEpisode {
  id              String   @id @map("id")
  idPatient       String   @map("id_patient")
  // Ancre de cycle `T0`, `T1`, `T2`, … (série OUVERTE depuis `D-113`) ou jalon
  // de mesure `J21`/`J42`/`J90`. La FORME est tenue par un CHECK et l'identité
  // de cycle par deux index partiels, tous trois en SQL brut : Prisma ne sait
  // les déclarer, le contrat `prisma/checks/episodes_identite_cycle_v1.sql`
  // les garde (`D-114`).
  milestone       String   @map("milestone")
  targetAt        DateTime @map("target_at")
  confirmedAt     DateTime @map("confirmed_at")
  payload         Json     @map("payload")
  payloadHash     String   @map("payload_hash")
  contractVersion String   @map("contract_version") // objets-cliniques-v1
  // Identité de cycle (C2B / Vague 2, gate G2). Nullables : une ligne héritée
  // non rattachable reste NULL, jamais devinée.
  cycleId         String?  @map("cycle_id")
  versionScore    String?  @map("version_score") // figé à la mesure (A8-3)
  createdAt       DateTime @default(now()) @map("created_at")

  patient        Patient         @relation(fields: [idPatient], references: [idPatient])
  protocolDrafts ProtocolDraft[]

  @@index([idPatient, milestone], map: "c2a_episode_patient_milestone_idx")
  @@index([idPatient, confirmedAt], map: "c2a_episode_patient_confirmed_idx")
  @@index([idPatient, cycleId], map: "c2b_episode_cycle_idx")
  @@map("assessment_episodes")
}

// SÉLECTION PRATICIEN D'UNE PRIORITÉ ([[D-127]]) — l'acte qui manquait à la
// chaîne C1. `buildProtocolDraft` l'exige depuis toujours, et AUCUN module de
// `src/` n'en produisait : les deux sites de construction de carte du cockpit
// passaient `selectionPraticien: null`. Enregistrer une version de protocole
// était donc IMPOSSIBLE depuis l'application — constat OBSERVÉ sur un parcours
// réel le 2026-09-06 ([[D-125]]), et non plus seulement démontré dans le code.
//
// APPEND-ONLY CHAÎNÉ, et ce n'est pas une préférence de style : `selectedAt`
// entre dans l'empreinte de la carte, et chaque version ancre sa provenance sur
// `protocol_drafts.decision_card_input_hash`. Une sélection mise à jour EN
// PLACE ferait pointer l'ancre d'une version DÉJÀ ENREGISTRÉE vers une carte
// que la base ne saurait plus reconstruire — `refusChaineC1` refuserait alors
// une version que le praticien avait légitimement écrite.
//
// Table fille de `patients` : entre dans la transaction d'effacement IDP2 DÈS
// CETTE PR (le banc de complétude dérive du schéma — précédent
// `resultats_biologiques`). La LECTURE, elle, n'arrive qu'après application
// constatée de la migration : le déploiement du code précède la migration
// ([[D-087]]), et interroger ici une table encore absente ferait échouer la
// construction de la carte, donc le cockpit entier.
model DecisionPrioritySelection {
  id                    String   @id @default(cuid())
  idPatient             String   @map("id_patient")
  // `runtime-decision-<jalon>-<empreinte de proposition>` : stable pour un même
  // dossier, jalon et proposition — c'est l'identité de la carte, pas celle de
  // son contenu.
  decisionCardId        String   @map("decision_card_id")
  // Empreinte de la carte AU MOMENT DU CHOIX. Elle NE BARRE RIEN ([[D-127]]
  // §2) : `buildDecisionCard` refuse déjà une sélection dont le recalcul
  // serveur ne produit pas le candidat, et gater ici refuserait en plus des
  // sélections encore valides. Elle sert à ce que le DÉSACCORD SE DISE — sans
  // elle, une sélection devenue inapplicable fait jeter la construction, et le
  // rejeu du cockpit sert « proposition » : l'épisode confirmé redeviendrait un
  // formulaire à confirmer, ce que [[D-118]] a fermé. CHECK migration : 64
  // caractères hexadécimaux minuscules, la forme que rend `canonicalSha256`.
  decisionCardInputHash String   @map("decision_card_input_hash")
  // `priority:<id de règle>` — dérivé de la RÈGLE clinique, jamais de
  // l'instance de carte : c'est ce qui lui permet de survivre à un recalcul.
  candidateId           String   @map("candidate_id")
  // Le motif écrit du praticien : la décision elle-même, pas une note
  // facultative — c'est ce qu'une version de protocole citera, et ce qui se
  // relit six semaines plus tard (CHECK : non vide, ≤ 2000, borne de
  // `note_courte` sur `arbitrages_biologiques` — même nature, même borne).
  rationale             String   @map("rationale")
  selectedAt            DateTime @default(now()) @map("selected_at")
  // E-mail de session, posé CÔTÉ SERVEUR (patron `arbitre_par`) : l'écran ne
  // transmet ni auteur ni horodatage. À NE PAS CONFONDRE avec le `selectedBy`
  // du contrat C1, qui vaut la constante `'practitioner'` — `buildDecisionCard`
  // refuse toute autre valeur, et c'est ce refus qui interdit de faire passer
  // la proposition du moteur pour la décision d'un praticien.
  selectedByEmail       String   @map("selected_by_email")
  // Référence SOUPLE, sans clé étrangère : patron des autres chaînes
  // `supersedes_*` du dépôt. La ligne visée est validée côté route.
  supersedesSelectionId String?  @map("supersedes_selection_id")
  createdAt             DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  // DEUX GARDES, et ensemble le fil d'une carte est STRICTEMENT LINÉAIRE : la
  // fourche n'est pas représentable. Resserrement ASSUMÉ par rapport aux autres
  // chaînes du dépôt, qui la tolèrent et la tranchent à la lecture — ici deux
  // sélections concurrentes de la même carte seraient deux praticiens croyant
  // chacun avoir décidé, et la base refuse plutôt que d'élire ([[D-127]] §3bis).
  //
  // LA GARDE DE RACINE VIT DANS LA MIGRATION SEULE : Prisma ne sait pas
  // exprimer un index partiel (même situation que `resultats_biologiques`).
  // `c1_selection_priorite_racine_unique` est UNIQUE sur (patient, carte)
  // `WHERE supersedes_selection_id IS NULL`. Ne pas redéclarer ici un
  // `@@unique([idPatient, decisionCardId])` : il recréerait l'index TOTAL et
  // rendrait toute correction impossible. Ce commentaire N'EST PAS une garde —
  // c'est le contrat `c1_selection_priorite_v1_negatif.sql` qui tient la
  // régression, par la forme des index et par le cas de la fourche.
  @@unique([supersedesSelectionId], map: "c1_selection_priorite_supersedes_unique")
  @@index([idPatient, decisionCardId, selectedAt], map: "c1_selection_priorite_carte_idx")
  @@map("decision_priority_selections")
}

// Version append-only du protocole 21 jours. PK = protocolDraftId du contrat.
// Colonnes d'ancrage de provenance (chaîne snapshot→review→decision-card) sans
// persister les objets dérivés. Correction = nouvelle ligne (supersedesDraftId).
model ProtocolDraft {
  id                    String    @id @map("id")
  idPatient             String    @map("id_patient")
  assessmentEpisodeId   String?   @map("assessment_episode_id")
  decisionCardId        String    @map("decision_card_id")
  decisionCardInputHash String    @map("decision_card_input_hash")
  snapshotInputHash     String    @map("snapshot_input_hash")
  reviewInputHash       String    @map("review_input_hash")
  selectedPriorityId    String    @map("selected_priority_id")
  status                String    @default("draft") @map("status") // draft | practitioner_reviewed
  payload               Json      @map("payload")
  inputHash             String    @map("input_hash")
  contractVersion       String    @map("contract_version") // c1-protocol-draft-v1
  supersedesDraftId     String?   @map("supersedes_draft_id")
  reviewedAt            DateTime? @map("reviewed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  patient               Patient                     @relation(fields: [idPatient], references: [idPatient])
  episode               AssessmentEpisode?          @relation(fields: [assessmentEpisodeId], references: [id])
  checkins              ProtocolCheckin[]
  diffusionApprovals    ProtocolDiffusionApproval[]
  arbitragesBiologiques ArbitrageBiologique[]
  // Signalements d'effet indésirable rattachés à ce protocole (D-101, DC-42).
  effetsIndesirables    TrustAdverseEffectReport[]

  @@index([idPatient, createdAt], map: "c2a_draft_patient_created_idx")
  @@index([decisionCardId], map: "c2a_draft_decision_card_idx")
  @@index([supersedesDraftId], map: "c2a_draft_supersedes_idx")
  @@map("protocol_drafts")
}

// Check-in patient J7/J14/J21 — instrument de pilotage, jamais un score ni un
// jalon de mesure (arbitrage A1). Écriture via session portail vérifiée
// (assignation) ; chemin legacy email-gate exclu. Append-only chaîné.
model ProtocolCheckin {
  id                  String   @id @default(cuid()) @map("id")
  idPatient           String   @map("id_patient")
  idAssignation       String   @map("id_assignation")
  protocolDraftId     String   @map("protocol_draft_id")
  pointEtape          String   @map("point_etape") // J7 | J14 | J21
  reponses            Json     @map("reponses")
  canal               String   @default("portail") @map("canal")
  supersedesCheckinId String?  @map("supersedes_checkin_id")
  soumisLe            DateTime @default(now()) @map("soumis_le")

  patient     Patient       @relation(fields: [idPatient], references: [idPatient])
  assignation Assignation   @relation(fields: [idAssignation], references: [idAssignation])
  draft       ProtocolDraft @relation(fields: [protocolDraftId], references: [id])

  @@index([idPatient, pointEtape], map: "c2a_checkin_patient_point_idx")
  @@index([protocolDraftId], map: "c2a_checkin_draft_idx")
  @@index([idAssignation], map: "c2a_checkin_assignation_idx")
  @@map("protocol_checkins")
}

// Agenda du sommeil 21 nuits (Q_SOM_09) — une ligne = une nuit déclarée par le
// patient. Patron ProtocolCheckin : append-only chaîné (supersedesNuitId),
// écriture via session portail uniquement. `dateNuit` = date CALENDAIRE du
// RÉVEIL (AAAA-MM-JJ, horloge murale locale) ; les heures sont des chaînes
// HH:MM locales dans `reponses` — aucune conversion de fuseau (cf.
// lib/agenda-sommeil). Les agrégats ne vivent PAS ici : ils sont produits à la
// clôture dans une QuestionnaireReponse standard (compatibilité fiche/inbox/
// équilibre). Toute nouvelle table fille de `patients` doit entrer dans la
// transaction d'effacement IDP2 (lib/patient/effacement.ts).
model AgendaSommeilNuit {
  id               String   @id @default(cuid()) @map("id")
  idPatient        String   @map("id_patient")
  idAssignation    String   @map("id_assignation")
  dateNuit         String   @map("date_nuit") // AAAA-MM-JJ (matin du réveil)
  reponses         Json     @map("reponses") // contrat agenda-sommeil-v1
  canal            String   @default("portail") @map("canal")
  supersedesNuitId String?  @map("supersedes_nuit_id")
  soumisLe         DateTime @default(now()) @map("soumis_le")

  patient     Patient     @relation(fields: [idPatient], references: [idPatient])
  assignation Assignation @relation(fields: [idAssignation], references: [idAssignation])

  @@index([idPatient, dateNuit], map: "agd_som_patient_date_idx")
  @@index([idAssignation, dateNuit], map: "agd_som_assignation_date_idx")
  @@map("agenda_sommeil_nuits")
}

// Agenda alimentaire 21 jours (Q_ALI_09) — une ligne = une journée déclarée par
// le patient. Patron AgendaSommeilNuit : append-only chaîné (supersedesJourId),
// écriture via session portail uniquement.
//
// `dateJour` = journée LOCALE ANCRÉE À 04:00 (AAAA-MM-JJ) : une prise à 00:30
// appartient à la veille. Sans cette ancre, une prise nocturne casserait à la
// fois l'ordre des prises et le calcul du jeûne. Les heures sont des chaînes
// HH:MM locales dans `reponses` — aucune conversion de fuseau (cf.
// lib/agenda-alimentaire).
//
// FRONTIÈRE JA : ce JSONB ne porte AUCUNE quantité, aucun gramme, aucune kcal,
// et aucun aliment identifié au-delà des trois présences déclarées. Aucun
// agrégat, aucun score, aucun indice n'y vit — le scorer reste `journal`
// (scored:false) tant qu'aucune donnée observée n'existe.
//
// AUCUNE CONTRAINTE UNIQUE sur (id_assignation, date_jour), délibérément : les
// lignes supplantées restent, et « lignes − dates distinctes » est le taux de
// correction, seul signal de friction lisible sans nouvelle migration.
//
// Toute nouvelle table fille de `patients` doit entrer dans la transaction
// d'effacement IDP2 (lib/patient/effacement.ts).
model AgendaAlimentaireJour {
  id               String   @id @default(cuid()) @map("id")
  idPatient        String   @map("id_patient")
  idAssignation    String   @map("id_assignation")
  dateJour         String   @map("date_jour") // AAAA-MM-JJ (journée 04:00 → 03:59)
  reponses         Json     @map("reponses") // contrat agenda-alimentaire-v1
  canal            String   @default("portail") @map("canal")
  supersedesJourId String?  @map("supersedes_jour_id")
  soumisLe         DateTime @default(now()) @map("soumis_le")

  patient     Patient     @relation(fields: [idPatient], references: [idPatient])
  assignation Assignation @relation(fields: [idAssignation], references: [idAssignation])

  @@index([idPatient, dateJour], map: "agd_ali_patient_date_idx")
  @@index([idAssignation, dateJour], map: "agd_ali_assignation_date_idx")
  @@map("agenda_alimentaire_jours")
}

// Approbation praticien « pour diffusion » (C2A LOT-03 Part B). Mapping 1:1 du
// contrat ProtocolDiffusionApproval : « Validé pour diffusion », distinct de la
// relecture (reviewed_at). Append-only chaîné (supersedes_approval_id) — jamais
// de réécriture. Ancrée par protocol_draft_input_hash : caduque dès qu'une
// nouvelle version du protocole est enregistrée. Ne déclenche AUCUN envoi
// patient (transmission différée à un lot ultérieur).
model ProtocolDiffusionApproval {
  id                     String   @id @default(cuid()) @map("id")
  idPatient              String   @map("id_patient")
  protocolDraftId        String   @map("protocol_draft_id")
  decisionCardInputHash  String   @map("decision_card_input_hash")
  protocolDraftInputHash String   @map("protocol_draft_input_hash")
  approvedAt             DateTime @map("approved_at")
  approvedBy             String   @default("practitioner") @map("approved_by")
  confirmation           String   @map("confirmation") // content_approved_for_diffusion
  supersedesApprovalId   String?  @map("supersedes_approval_id")
  createdAt              DateTime @default(now()) @map("created_at")

  patient Patient       @relation(fields: [idPatient], references: [idPatient])
  draft   ProtocolDraft @relation(fields: [protocolDraftId], references: [id])

  @@index([idPatient], map: "c2a_diffusion_patient_idx")
  @@index([protocolDraftId], map: "c2a_diffusion_draft_idx")
  @@map("protocol_diffusion_approvals")
}

// Refus d'une carte du Fil (SP-FIL, gate G1). Le garde-fou 5.0 exige qu'une
// carte soit refusable, que le refus PERSISTE (elle ne revient pas le
// lendemain) et qu'il reste RÉVERSIBLE.
//
// `carte_cle` est l'identité de la carte, ancrée sur sa ligne source (voir
// `lib/fil/cartes.ts`, `cleCarte`). Les cartes étant des projections
// recalculées à chaque ouverture, c'est cette clé — et non la carte — qui est
// désignée ici.
//
// Append-only chaîné : annuler un refus n'efface ni ne réécrit rien, c'est une
// nouvelle ligne (`refusee = false`) qui supplante la précédente. L'état courant
// est la tête de chaîne. C'est pourquoi il n'y a **pas** de contrainte d'unicité
// sur (id_patient, carte_cle) : plusieurs lignes coexistent par construction,
// et une unicité rendrait justement l'annulation impossible.
//
// Aucune ligne ne signifie « non refusée » — l'état de toutes les cartes avant
// ce gate.
model FilCardRejection {
  id                    String   @id @default(cuid()) @map("id")
  idPatient             String   @map("id_patient")
  carteCle              String   @map("carte_cle")
  refusee               Boolean  @default(true) @map("refusee")
  refusePar             String   @map("refuse_par")
  supersedesRejectionId String?  @map("supersedes_rejection_id")
  refuseLe              DateTime @default(now()) @map("refuse_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, refuseLe], map: "g1_fil_rejection_patient_idx")
  @@index([idPatient, carteCle], map: "g1_fil_rejection_cle_idx")
  @@map("fil_card_rejections")
}

// Note de relecture (SP-TT LOT-02, gate G3). Le praticien annote un état passé
// qu'il vient de relire.
//
// DEUX DATES, jamais confondues : `instant_relu` est une DONNÉE — l'instant que
// la note commente — tandis que `cree_le` est le moment de l'écriture, toujours
// le présent, et c'est la BASE qui le pose (@default(now())), jamais
// l'appelant. On n'écrit pas dans le passé, on écrit aujourd'hui à propos du
// passé. C'est l'invariant du gate.
//
// Append-only chaîné (supersedes_note_id) : corriger une note crée une ligne,
// la précédente reste lisible. Aucune réécriture, aucune suppression.
//
// PRATICIEN SEUL : aucune surface patient ne lit cette table — garde
// structurelle dans `lib/praticien/relectureNote.test.ts`.
model RelectureNote {
  id               String   @id @default(cuid()) @map("id")
  idPatient        String   @map("id_patient")
  praticienEmail   String   @map("praticien_email")
  instantRelu      DateTime @map("instant_relu")
  texte            String   @map("texte")
  supersedesNoteId String?  @map("supersedes_note_id")
  creeLe           DateTime @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "sptt_relecture_note_patient_idx")
  @@map("relecture_notes")
}

// Fil de correspondance médecin (C3 LOT-06, V1 = transcription praticien —
// décision FM-1 du cadrage du 2026-07-22). Le médecin n'accède à RIEN et
// l'application n'envoie RIEN : le praticien consigne un envoi fait par ses
// canaux habituels (sens « sortant ») et transcrit une réponse reçue (sens
// « entrant »).
//
// MINIMISATION (données d'un tiers) : le médecin n'est désigné que par un
// libellé libre (`medecin_libelle`) — ni adresse e-mail, ni RPPS, ni compte.
// Texte seul par construction : aucun champ fichier (mur HDS, décision de
// programme — le fil transporte des échanges, jamais de pièce biologique).
//
// DEUX DATES, jamais confondues (patron RelectureNote / SP-TT) : `echange_le`
// est une DONNÉE — la date de l'échange réel, telle que transcrite,
// facultative — tandis que `consigne_le` est le moment de l'écriture, posé
// par la BASE (@default(now())), jamais par l'appelant. Une consignation est
// inantidatable.
//
// CONSERVATION ALIGNÉE DOSSIER (FM-2) : dossier clos = consignation refusée
// par la route ; effacement = deleteMany nommément dans `effacerDossier`,
// forcé par la garde structurelle d'`effacement.test.ts`.
//
// `id_synthese` est une référence SOUPLE, sans FK (patron supersedes_note_id) :
// la route vérifie existence et appartenance au POST, et l'effacement du
// dossier emporte les deux tables dans la même transaction.
model CorrespondanceMedecin {
  id             String    @id @default(cuid()) @map("id")
  idPatient      String    @map("id_patient")
  praticienEmail String    @map("praticien_email")
  sens           String    @map("sens") // sortant | entrant
  medecinLibelle String    @map("medecin_libelle")
  texte          String    @map("texte")
  idSynthese     String?   @map("id_synthese")
  echangeLe      DateTime? @map("echange_le")
  consigneLe     DateTime  @default(now()) @map("consigne_le")
  // ANCRAGE DE PROVENANCE ([[D-073]]) — le SHA de la table clinique qui a
  // produit la lettre, et sa version. Nullables : une correspondance saisie à
  // la main n'est dérivée d'aucune table, et prétendre le contraire serait
  // pire que l'absence.
  //
  // POURQUOI UNE COLONNE ET NON UNE LIGNE DE TEXTE : une ancre en prose n'est
  // vérifiable par personne. Tout le programme [[D-063]]→[[D-067]] a consisté à
  // rendre la péremption DÉTECTABLE — un SHA qu'une garde peut comparer. Une
  // ancre noyée dans le corps de la lettre serait à la traçabilité ce qu'un
  // JSDoc est à une garde (dette M-B) : lisible, et sans effet.
  //
  // Les deux voyagent ENSEMBLE ou pas du tout (CHECK migration) : un SHA sans
  // version ne se rattache à rien, une version sans SHA n'atteste rien.
  ancrageSha256  String?   @map("ancrage_sha256")
  ancrageVersion String?   @map("ancrage_version")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, consigneLe], map: "c3_correspondance_medecin_patient_idx")
  @@map("correspondances_medecin")
}

// Lien magique d'accès au portail patient (IDP LOT-01, gate G4).
//
// Remplace PROGRESSIVEMENT le jeton permanent `patients.access_token`, qui est
// conservé : les deux chemins coexistent pendant la bascule, c'est une
// exigence du registre. Cette table n'enlève rien, elle ajoute une entrée.
//
// LE JETON N'EST PAS ICI. Seule son empreinte HMAC-SHA256 est stockée
// (`lib/portail/lienMagique.ts`, `empreinteJeton`) : un dump de la base ne
// permet donc pas d'ouvrir un espace patient. L'unicité sert la recherche par
// empreinte et interdit la collision.
//
// USAGE UNIQUE : `consomme_le` passe de null à un instant, une seule fois, dans
// la même transaction que la lecture d'état — sinon deux requêtes concurrentes
// consommeraient le même lien. Le rejeu n'est pas seulement refusé, il est
// TRACÉ : `rejeux_refuses` et `derniere_tentative_le` gardent la preuve en base,
// là où un log Vercel serait purgé.
//
// Aucune ligne ne signifie « aucun lien magique émis » — l'état de tous les
// patients avant ce gate, et l'état attendu tant que le drapeau est éteint.
model PortailMagicLink {
  id                String    @id @default(cuid()) @map("id")
  idPatient         String    @map("id_patient")
  jetonEmpreinte    String    @unique @map("jeton_empreinte")
  expireLe          DateTime  @map("expire_le")
  consommeLe        DateTime? @map("consomme_le")
  creePar           String    @map("cree_par")
  creeLe            DateTime  @default(now()) @map("cree_le")
  rejeuxRefuses     Int       @default(0) @map("rejeux_refuses")
  derniereTentative DateTime? @map("derniere_tentative_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "g4_magic_link_patient_idx")
  @@map("portail_magic_links")
}

// Tentatives de redemande de lien, comptées par origine réseau (gate G4).
//
// POURQUOI UNE TABLE ET PAS UN COMPTEUR EN MÉMOIRE : plusieurs instances
// serverless répondent en parallèle ; un compteur local ne borne rien. Et
// `portail_magic_links` ne peut pas tenir ce rôle — une adresse inconnue n'y
// crée aucune ligne, or c'est exactement la tentative à compter.
//
// AUCUNE RELATION VERS `patients`, DÉLIBÉRÉMENT. Pas de clé étrangère, pas de
// colonne d'identifiant patient : aucune jointure ne doit pouvoir relier une
// origine réseau à un dossier. La table sait combien, jamais pour qui.
//
// L'ADRESSE IP N'ENTRE PAS ICI. `empreinte_ip` est un HMAC-SHA256 (clé
// NEXTAUTH_SECRET, préfixe « portail-demande-ip: »). Les lignes se purgent
// au-delà de 24 h : passé la fenêtre de comptage, elles ne seraient plus qu'une
// trace d'origine réseau conservée sans usage.
model PortailDemandeTentative {
  id          String   @id @default(cuid()) @map("id")
  empreinteIp String   @map("empreinte_ip")
  creeLe      DateTime @default(now()) @map("cree_le")

  @@index([empreinteIp, creeLe], map: "g4_demande_ip_idx")
  @@index([creeLe], map: "g4_demande_purge_idx")
  @@map("portail_demande_tentatives")
}

// Trace durable des entrées par Google (gate G5, IDP2 LOT-03c-trace).
//
// POURQUOI. Le lien magique laisse une trace en base (`consomme_le`,
// `rejeux_refuses`) ; le chemin Google n'en laissait aucune — seulement un log
// Vercel, purgeable. La revue adversariale du 2026-07-21 en a fait un NO-GO à
// l'activation : trois mois après, « qui a ouvert ce dossier, quand, par quel
// chemin » n'aurait plus de réponse. Cette table est la réponse.
//
// CE QU'ELLE PORTE, ET CE QU'ELLE NE PORTE PAS. `id_patient` (l'identifiant
// synthétique, déjà partout ailleurs), l'instant, l'issue, et pour un refus sa
// catégorie interne. JAMAIS l'adresse e-mail, JAMAIS une empreinte, JAMAIS le
// jeton — même exigence de sobriété que `DossierEfface`. `id_patient` est
// nullable : un refus sur une adresse inconnue n'a pas de patient à nommer.
//
// SANS CLÉ ÉTRANGÈRE VERS `patients`, comme `audit_syntheses` et
// `booklet_envois`. `id_patient` est nullable (un refus sur adresse inconnue
// n'a pas de patient), et une FK sur une colonne nullable n'apporterait rien
// aux lignes sans parent. En contrepartie, rien dans la base ne protège cette
// table d'un oubli à l'effacement : c'est `effacerDossier` qui l'efface
// nommément, et `effacement.test.ts` échoue si une table portant `id_patient`
// y est oubliée. Un journal d'accès qui SURVIVRAIT à l'effacement le viderait
// de son sens — il continuerait à nommer le dossier qu'on vient de détruire.
//
// PAS DE PURGE AUTOMATIQUE, hors effacement. Contrairement à
// `portail_demande_tentatives` — un compteur de cadence sans valeur passé une
// heure — ceci est un journal d'accès : durer, tant que le dossier existe, est
// son objet. La durée de conservation générale est une décision de conformité,
// pas une constante de code : elle n'est pas encodée ici.
//
// ELLE N'EST ÉCRITE QU'APRÈS LA VÉRIFICATION DU `state`. Un retour forgé qui n'a
// pas franchi la garde anti-CSRF n'écrit aucune ligne : sans cela, marteler
// `/portail/google/retour` gonflerait la table sans borne.
model PortailConnexionGoogle {
  id        String   @id @default(cuid()) @map("id")
  idPatient String?  @map("id_patient")
  issue     String   @map("issue")
  motif     String?  @map("motif")
  creeLe    DateTime @default(now()) @map("cree_le")

  @@index([idPatient, creeLe], map: "g5_google_patient_idx")
  @@index([creeLe], map: "g5_google_scan_idx")
  @@map("portail_connexions_google")
}

// Journal des lectures praticien de dossier nommé (G-TRUST-04, exigence 5).
//
// POURQUOI. La journalisation applicative couvre erreurs et refus, en console
// Vercel purgeable ; le dépôt a acté (G5, ci-dessus) qu'un log purgeable ne
// vaut pas trace d'accès. « Qui a lu quel dossier, quand » doit avoir une
// réponse trois mois plus tard — cette table la porte pour le versant
// praticien ; le versant patient est déjà couvert (`PortailConnexionGoogle`,
// `PortailMagicLink.consommeLe`).
//
// CE QU'ELLE PORTE : le « qui » (`praticienEmail`), le « quel dossier »
// (`idPatient`, NOT NULL — on n'écrit qu'après appartenance établie), le
// « quand » (`creeLe`, posé par la base), le « par où » (`route` en gabarit
// littéral, `methode`). JAMAIS l'URL réelle, JAMAIS de payload, d'IP, de
// user-agent ni de donnée clinique.
//
// SANS CLÉ ÉTRANGÈRE VERS `patients` (comme `PortailConnexionGoogle`) :
// `effacerDossier` efface cette table nommément, `effacement.test.ts` échoue
// si on l'oublie. Rétention 12 mois glissants par purge opportuniste à
// l'écriture (décision GD-2 du 2026-07-22, alignée sur le précédent G5) —
// constante applicative, révisable sans migration.
model JournalAccesDossier {
  id             String   @id @default(cuid()) @map("id")
  idPatient      String   @map("id_patient")
  praticienEmail String   @map("praticien_email")
  route          String   @map("route")
  methode        String   @map("methode")
  creeLe         DateTime @default(now()) @map("cree_le")

  @@index([idPatient, creeLe], map: "acces_dossiers_patient_idx")
  @@index([creeLe], map: "acces_dossiers_scan_idx")
  @@map("journal_acces_dossiers")
}

// Résidu laissé par un effacement de dossier (IDP2).
//
// L'application PROMET l'effacement au patient
// (`lib/trust/contenus/registre.ts`). Quand il l'exerce, la ligne `patients` et
// ses seize tables filles sont supprimées ; il ne subsiste que cette ligne, dont
// le seul objet est que les comptages de l'historique clinique ne s'effondrent
// pas.
//
// CE QU'ELLE NE PEUT PAS CONTENIR, par construction : aucun identifiant
// patient, aucune clé étrangère, aucun prénom, aucune adresse. Le prénom
// figurait dans la décision initiale du 2026-07-21 et en a été retiré le même
// jour — sur quelques dizaines de dossiers, « prénom + trois lettres + année »
// redevenait rapprochable d'une personne, et le mot « effacement » n'aurait pas
// tenu. Même principe que `portail_demande_tentatives` : la table ne compte pas
// sur la discipline pour rester anonyme, elle en est incapable.
//
// C'est aussi la SEULE trace qu'un effacement a eu lieu : la demande
// enregistrée dans `trust_rights_requests` est supprimée par son propre
// traitement.
model DossierEfface {
  id             String   @id @default(cuid()) @map("id")
  anneeNaissance Int?     @map("annee_naissance")
  initialesNom   String   @map("initiales_nom")
  effaceLe       DateTime @default(now()) @map("efface_le")

  @@index([effaceLe], map: "idp2_dossier_efface_date_idx")
  @@map("dossiers_effaces")
}

// Proposition de pack de réévaluation (SP-SPI LOT-01). Le pack est PROPOSÉ au
// patient qui revient après une absence — jamais assigné : l'assignation reste
// un geste praticien, et cette table n'en crée aucune.
//
// POURQUOI ELLE EXISTE. Le lot s'interdisait toute écriture et exigeait en même
// temps un pack refusable. Les deux ne tiennent pas ensemble : un refus qu'on
// ne persiste pas revient à chaque visite, et une proposition qui revient EST
// une relance — ce que la campagne s'interdit explicitement. La donnée sert donc
// à NE PAS REDEMANDER, jamais à insister.
//
// CE QU'ELLE NE DÉCLENCHE PAS : aucune assignation, aucun envoi d'e-mail, aucun
// compte à rebours, aucune relance. Un refus reste sans conséquence pour le
// patient — c'est un invariant de la campagne, pas une propriété de cette table.
//
// Append-only chaîné (supersedes_proposition_id), comme `trust_choice_events` et
// `fil_card_rejections` : répondre à une proposition crée une SECONDE ligne qui
// supplante la première, laquelle reste lisible. Aucune réécriture, aucune
// suppression, et donc aucune contrainte d'unicité sur (id_patient, id_pack) —
// elle rendrait la réponse impossible. Les index servent la lecture seule.
//
// `id_pack` n'est PAS une clé étrangère vers `packs` : la proposition consigne
// ce qui a été proposé au moment où ça l'a été, et doit survivre à la
// désactivation du pack — même raison que `version_score` figée à la mesure.
model PackProposition {
  id                      String   @id @default(cuid()) @map("id")
  idPatient               String   @map("id_patient")
  idPack                  String   @map("id_pack")
  statut                  String   @map("statut") // proposee | acceptee | declinee
  // « systeme » pose la proposition, « patient » y répond. Jamais déduit de la
  // valeur de `statut` : qui écrit et ce qui est écrit restent deux choses.
  acteurRole              String   @map("acteur_role")
  supersedesPropositionId String?  @map("supersedes_proposition_id")
  enregistreLe            DateTime @default(now()) @map("enregistre_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, enregistreLe], map: "sp_spi_pack_proposition_patient_idx")
  @@index([idPatient, idPack], map: "sp_spi_pack_proposition_pack_idx")
  @@map("pack_propositions")
}

// Bibliothèque — file d'envoi de questionnaires (arbitrage utilisateur du
// 2026-07-23 : « file simple, envoi au clic »). Un brouillon par patient et
// par praticien accumule des questionnaires ; « Préparer les envois » crée
// les assignations en transaction (patron packs/assign) et envoie UN mail
// récapitulatif avec le lien portail unique. La ligne passe alors à
// `statut: "parti"` et reste comme trace ; un nouvel ajout rouvre un
// brouillon neuf. Pas de cron, pas de relance automatique.
//
// `qids` ne sont PAS des clés étrangères : le brouillon consigne une
// intention d'envoi contre le catalogue en code (QUESTIONNAIRE_CATALOGUE),
// qui n'a pas de table. La validation des ids se fait à l'écriture et à
// l'envoi, jamais par contrainte.
model EnvoiBrouillon {
  id             String    @id @default(cuid())
  idBrouillon    String    @unique @map("id_brouillon")
  praticienEmail String    @map("praticien_email")
  idPatient      String    @map("id_patient")
  qids           String[]  @default([]) @map("qids")
  statut         String    @default("brouillon") @map("statut") // brouillon | parti
  dateLimite     String?   @map("date_limite")
  notes          String?   @map("notes")
  dateEnvoi      DateTime? @map("date_envoi")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([praticienEmail, statut], map: "bibliotheque_envoi_brouillon_praticien_idx")
  @@index([idPatient, statut], map: "bibliotheque_envoi_brouillon_patient_idx")
  @@map("envoi_brouillons")
}

// Instruments du cabinet (décision utilisateur du 2026-07-23) : un praticien
// crée ou importe un questionnaire privé à son cabinet, avec grille de score
// et interprétation. Il n'est JAMAIS certifié automatiquement ; sa grille doit
// être relue puis publiée (`statutRelecture: "valide"`) avant d'être
// assignable. Une fois publié, il part par la file d'envoi et se score à la
// soumission comme un instrument du catalogue (resolver commun
// `@/lib/instruments`). Pas de FK praticien : le praticien n'existe que par
// l'email de session (hypothèse mono-praticien, patron EnvoiBrouillon).
model CabinetInstrument {
  id              String   @id @default(cuid())
  idInstrument    String   @unique @map("id_instrument") // CAB_xxx (createPublicId('CAB'))
  praticienEmail  String   @map("praticien_email")
  titre           String
  categorie       String   @default("Cabinet")
  description     String?
  definitionJson  Json     @map("definition_json") // { instructions?: string, sections: Section[] }
  scoringJson     Json     @map("scoring_json") // { type, reversed?, interpretation: [...] }
  statutRelecture String   @default("brouillon") @map("statut_relecture") // brouillon | grille_a_relire | valide
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([praticienEmail, actif], map: "cabinet_instrument_praticien_idx")
  @@map("cabinet_instruments")
}


// Rendez-vous praticien (accueil-observatoire LOT-04) — objet OPÉRATIONNEL
// minimal qui dé-diffère le workflow RDV (R6 produit / E5, registre §4). Ni
// récurrence, ni notification, ni surface patient : il alimente les cartes
// « Pré-vol prêt » du Fil et l'écran agenda. `date_heure` est une DONNÉE (le
// moment planifié) ; `cree_le` est posé par la base, jamais par l'appelant.
// L'annulation est un STATUT (`annule`), jamais une suppression : le
// rendez-vous reste une trace, `annule_le` datant le geste.
model RendezVous {
  id             String    @id @default(cuid()) @map("id")
  idPatient      String    @map("id_patient")
  praticienEmail String    @map("praticien_email")
  dateHeure      DateTime  @map("date_heure")
  motif          String?   @map("motif")
  statut         String    @default("planifie") @map("statut") // planifie | annule
  annuleLe       DateTime? @map("annule_le")
  creeLe         DateTime  @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([praticienEmail, dateHeure], map: "ao_rendez_vous_praticien_date_idx")
  @@index([idPatient, dateHeure], map: "ao_rendez_vous_patient_date_idx")
  @@map("rendez_vous")
}


// ─── CATALOGUE BIOLOGIE FONCTIONNELLE CB-A (campagne CB, LOT CB-01) ─────────
// Cadrage : docs/claude/propositions/2026-07-25-rayon-biologie-fonctionnelle/
// Étage 1 DOCUMENTAIRE uniquement. AUCUNE de ces tables ne porte de valeur
// biologique patient : le stockage d'un résultat est un acte gaté HDS (étage 2,
// lot CB-09, second flag WN_CB_RESULTS_ENABLED). Une table de ce bloc qui se
// mettrait à porter une mesure patient romprait le verrou.
//
// L'audit de la source (AUDIT-SOURCE-NABM.md) impose la séparation centrale de
// ce schéma : la nomenclature n'est PAS l'ossature du catalogue. Les actes
// importés vivent dans `biology_nabm_actes` (matière administrative, verbatim
// source) ; le pivot clinique est `biology_analytes`, alimenté par le praticien
// et le corpus. Les deux ne se rejoignent que par une correspondance manuelle
// et signée (`biology_analyte_nabm`), jamais par rapprochement de libellés —
// le filtre de la source rend des faux négatifs silencieux (audit §5).

// Pivot clinique du rayon. Entité STABLE : contrairement au produit C4, un
// analyte n'a pas de versions successives (la ferritine ne change pas) — c'est
// la NOMENCLATURE qui est versionnée, côté biology_nabm_actes.
model BiologyAnalyte {
  id                  String    @id @default(cuid())
  code                String    @unique @map("code")
  libelle             String    @map("libelle")
  libellePatient      String?   @map("libelle_patient")
  unite               String?   @map("unite")
  typePrelevement     String    @map("type_prelevement")
  delaiRenduIndicatif String?   @map("delai_rendu_indicatif")
  sourceProvenance    String    @map("source_provenance")
  sourceIdentifiant   String?   @map("source_identifiant")
  statutFiche         String    @default("importee") @map("statut_fiche")
  niveauCompletude    String    @map("niveau_completude")
  contenuSha256       String?   @map("contenu_sha256")
  donneesManquantes   String[]  @default([]) @map("donnees_manquantes")
  incertitudes        String?   @map("incertitudes")
  verifiePar          String?   @map("verifie_par")
  verifieLe           DateTime? @map("verifie_le")
  /// Interprétation sous validation médicale obligatoire (`D-068` §4,
  /// arbitrage F.6 du catalogue niveau 1) : règle de sécurité PRODUIT, posée
  /// explicitement — aucun claim ne la fonde, et c'est dit. Seule
  /// l'insulinémie la porte à la livraison.
  validationMedicaleRequise Boolean @default(false) @map("validation_medicale_requise")
  actif               Boolean   @default(true) @map("actif")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  correspondancesNabm  BiologyAnalyteNabm[]
  plagesReference      BiologyReferenceRange[]
  plagesFonctionnelles BiologyFunctionalRange[]
  preanalytiques       BiologyPreanalytic[]
  liensCliniques       BiologyAnalyteLink[]
  itemsPanel           BiologyPanelItem[]
  ratiosOperandeA      BiologyRatio[]          @relation("ratio_operande_a")
  ratiosOperandeB      BiologyRatio[]          @relation("ratio_operande_b")
  resultats            ResultatBiologique[]

  @@index([statutFiche, actif], map: "biology_analytes_statut_idx")
  @@index([typePrelevement], map: "biology_analytes_prelevement_idx")
  @@map("biology_analytes")
}

// Nomenclature des actes de biologie médicale, importée verbatim depuis le
// Serveur Multi-Terminologies de l'ANS (LOv2). Destination de l'import CB-02a
// (988 actes). Table ADMINISTRATIVE : aucun champ clinique, la source n'en
// porte aucun (ni unité, ni préanalytique, ni valeur de référence).
// Le tarif en euros n'y figure pas non plus — seul `coefficient_b` existe, la
// valeur de la lettre-clé relevant d'un arrêté : ne jamais afficher d'euros.
model BiologyNabmActe {
  id                           String    @id @default(cuid())
  codeActe                     String    @map("code_acte")
  versionSource                String    @map("version_source")
  versionPublieeLe             DateTime? @map("version_publiee_le")
  libelle                      String    @map("libelle")
  coefficientB                 Int?      @map("coefficient_b")
  codeParent                   String?   @map("code_parent")
  ententePrealable             Boolean?  @map("entente_prealable")
  examenSanguin                Boolean?  @map("examen_sanguin")
  indicationMedicale           Boolean?  @map("indication_medicale")
  nombreMaxParFacturation      Int?      @map("nombre_max_par_facturation")
  initiativeBiologistePossible Boolean?  @map("initiative_biologiste_possible")
  rmo                          Boolean?  @map("rmo")
  remboursementTotal           Boolean?  @map("remboursement_total")
  acteReserve                  Boolean?  @map("acte_reserve")
  inactif                      Boolean   @default(false) @map("inactif")
  // Actes non cumulables sur une même demande — 1208 (T.S.H. seule) exclut
  // 1211 (T.S.H. + T4 libre). Verbatim de la source. NULL, jamais `{}` :
  // le CHECK en base interdit le tableau vide pour n'avoir qu'une écriture
  // de « aucune incompatibilité ».
  codeIncompatible             String[]  @map("code_incompatible")
  regleApplicable              String[]  @map("regle_applicable")
  contenuSha256                String?   @map("contenu_sha256")
  importeLe                    DateTime  @default(now()) @map("importe_le")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  // Pas de relation vers BiologyAnalyteNabm : la correspondance est ancrée sur
  // le CODE d'acte, qui traverse les millésimes, et non sur la ligne d'un
  // millésime donné. `codeParent` reçoit le `parent` de la source — souvent un
  // sous-chapitre (« 06-04 »), pas un chapitre : le nom ne promet donc rien de
  // plus que ce que la source donne.
  @@unique([codeActe, versionSource], map: "biology_nabm_actes_code_version_key")
  @@index([versionSource, inactif], map: "biology_nabm_actes_version_idx")
  @@map("biology_nabm_actes")
}

// Correspondance analyte ↔ acte, PLUSIEURS-À-PLUSIEURS dans les deux sens
// (audit §7) : la TSH se cote seule (1208), avec T4L (1211) ou avec T4L+T3L
// (1212) ; et l'acte 1387 couvre folates sériques OU érythrocytaires.
//
// ANCRÉE SUR `codeActe`, PAS SUR L'IDENTIFIANT D'UNE LIGNE DE MILLÉSIME : la
// signature du praticien porte sur un code de nomenclature, qui traverse les
// versions. L'attacher à la ligne (code, V105) l'aurait périmée au millésime
// suivant — soit en laissant lire un `inactif` obsolète, soit en faisant
// basculer tout le catalogue en « non remboursé » après chaque import.
// L'acte se résout au millésime courant via le pointeur de version. Le prix
// est l'absence de clé étrangère (le code seul n'est pas unique dans la table
// des actes) ; le contrat SQL vérifie la résolution à la place.
//
// Une ligne non signée est une PROPOSITION de rapprochement, pas une
// correspondance : le caractère remboursable se dérive des seules lignes
// signées. Il n'existe volontairement PAS de colonne `remboursable` sur
// l'analyte — un booléen stocké divergerait de la correspondance qui le fonde,
// et le cadrage exige qu'il ne soit jamais inféré. La dérivation est écrite une
// seule fois, dans `web/src/lib/biology-library/remboursable.ts`.
model BiologyAnalyteNabm {
  id          String    @id @default(cuid())
  analyteCode String    @map("analyte_code")
  codeActe    String    @map("code_acte")
  nature      String    @map("nature")
  commentaire String?   @map("commentaire")
  verifiePar  String?   @map("verifie_par")
  verifieLe   DateTime? @map("verifie_le")
  createdAt   DateTime  @default(now()) @map("created_at")

  analyte BiologyAnalyte @relation(fields: [analyteCode], references: [code])

  @@unique([analyteCode, codeActe], map: "biology_analyte_nabm_analyte_acte_key")
  @@index([codeActe], map: "biology_analyte_nabm_code_acte_idx")
  @@map("biology_analyte_nabm")
}

// Référentiel 1/2 — valeurs de référence LABORATOIRE. Ne demande aucun claim :
// c'est une donnée d'appareil, pas une interprétation clinique.
// Cible POLYMORPHE : un analyte OU un ratio. Le cadrage §3 impose aux ratios
// « les mêmes deux référentiels de valeurs séparés » — HOMA, ω6/ω3, Cu/Zn et
// saturation de la transferrine ont tous une plage.
model BiologyReferenceRange {
  id            String   @id @default(cuid())
  analyteCode   String?  @map("analyte_code")
  ratioCode     String?  @map("ratio_code")
  borneMin      Float?   @map("borne_min")
  borneMax      Float?   @map("borne_max")
  unite         String   @map("unite")
  population    String   @default("adulte_tout_venant") @map("population")
  sourceLibelle String   @map("source_libelle")
  sourceUrl     String?  @map("source_url")
  actif         Boolean  @default(true) @map("actif")
  createdAt     DateTime @default(now()) @map("created_at")

  analyte BiologyAnalyte? @relation(fields: [analyteCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  ratio   BiologyRatio?   @relation(fields: [ratioCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@index([analyteCode, actif], map: "biology_reference_ranges_analyte_idx")
  @@index([ratioCode, actif], map: "biology_reference_ranges_ratio_idx")
  @@map("biology_reference_ranges")
}

// Référentiel 2/2 — plages FONCTIONNELLES optimales. INVARIANT MIROIR DE
// L'ORIENTATION : `claim_id` et `version_claim` sont NOT NULL — une plage
// fonctionnelle sans claim validé n'existe pas, donc n'est jamais servie.
// Les deux référentiels ne fusionnent jamais : l'UI les présente côte à côte.
// Pas de FK vers rag_corpus_claims — table SQL-brut hors schema.prisma
// (prisma.config.ts, tables.external) ; le lien se vérifie à la lecture, comme
// pour les claims des règles d'orientation.
model BiologyFunctionalRange {
  id           String   @id @default(cuid())
  analyteCode  String?  @map("analyte_code")
  ratioCode    String?  @map("ratio_code")
  borneMin     Float?   @map("borne_min")
  borneMax     Float?   @map("borne_max")
  unite        String   @map("unite")
  population   String   @default("adulte_tout_venant") @map("population")
  claimId      String   @map("claim_id")
  versionClaim String   @map("version_claim")
  niveauPreuve String   @map("niveau_preuve")
  actif        Boolean  @default(true) @map("actif")
  createdAt    DateTime @default(now()) @map("created_at")

  analyte BiologyAnalyte? @relation(fields: [analyteCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  ratio   BiologyRatio?   @relation(fields: [ratioCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@index([analyteCode, actif], map: "biology_functional_ranges_analyte_idx")
  @@index([ratioCode, actif], map: "biology_functional_ranges_ratio_idx")
  @@index([claimId], map: "biology_functional_ranges_claim_idx")
  @@map("biology_functional_ranges")
}

// Conditions de prélèvement. Sourcées par claim QUAND elles viennent du corpus
// (paire claim_id/version_claim tout-ou-rien) ; une condition purement
// logistique (tube, délai d'acheminement) n'en demande pas.
model BiologyPreanalytic {
  id            String   @id @default(cuid())
  analyteCode   String   @map("analyte_code")
  typeCondition String   @map("type_condition")
  consigne      String   @map("consigne")
  claimId       String?  @map("claim_id")
  versionClaim  String?  @map("version_claim")
  actif         Boolean  @default(true) @map("actif")
  createdAt     DateTime @default(now()) @map("created_at")

  analyte BiologyAnalyte @relation(fields: [analyteCode], references: [code])

  @@index([analyteCode, actif], map: "biology_preanalytics_analyte_idx")
  @@map("biology_preanalytics")
}

// Ratios calculés déterministes. SPÉCIFICATION STRUCTURÉE D'OPÉRANDES, jamais
// une expression libre exécutable (patron ScoringSpecification) : l'opération
// est un vocabulaire fermé de trois formes, les opérandes sont des analytes du
// catalogue, la constante est un nombre. Rien n'est évalué depuis du texte.
model BiologyRatio {
  id            String   @id @default(cuid())
  code          String   @unique @map("code")
  libelle       String   @map("libelle")
  operation     String   @map("operation")
  analyteACode  String   @map("analyte_a_code")
  analyteBCode  String   @map("analyte_b_code")
  constante     Float?   @map("constante")
  uniteResultat String?  @map("unite_resultat")
  actif         Boolean  @default(true) @map("actif")
  createdAt     DateTime @default(now()) @map("created_at")

  analyteA             BiologyAnalyte           @relation("ratio_operande_a", fields: [analyteACode], references: [code])
  analyteB             BiologyAnalyte           @relation("ratio_operande_b", fields: [analyteBCode], references: [code])
  itemsPanel           BiologyPanelItem[]
  plagesReference      BiologyReferenceRange[]
  plagesFonctionnelles BiologyFunctionalRange[]
  liensCliniques       BiologyAnalyteLink[]

  @@index([analyteACode], map: "biology_ratios_analyte_a_idx")
  @@index([analyteBCode], map: "biology_ratios_analyte_b_idx")
  @@map("biology_ratios")
}

// Bilans hiérarchisés — mêmes niveaux que les explorations du moteur
// d'orientation NNPP2 (socle | approfondissement | specialise).
model BiologyPanel {
  id        String   @id @default(cuid())
  code      String   @unique @map("code")
  libelle   String   @map("libelle")
  niveau    String   @map("niveau")
  objectif  String?  @map("objectif")
  besoins   Int[]    @default([]) @map("besoins")
  actif     Boolean  @default(true) @map("actif")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items      BiologyPanelItem[]
  documentes PanelBiologieDocumente[]

  @@map("biology_panels")
}

// Un item de bilan porte SOIT un analyte SOIT un ratio, jamais les deux ni
// aucun (CHECK cible_unique dans la migration).
model BiologyPanelItem {
  id          String   @id @default(cuid())
  panelCode   String   @map("panel_code")
  analyteCode String?  @map("analyte_code")
  ratioCode   String?  @map("ratio_code")
  position    Int      @default(0) @map("position")
  createdAt   DateTime @default(now()) @map("created_at")

  panel   BiologyPanel    @relation(fields: [panelCode], references: [code])
  analyte BiologyAnalyte? @relation(fields: [analyteCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  ratio   BiologyRatio?   @relation(fields: [ratioCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@index([panelCode, position], map: "biology_panel_items_panel_idx")
  @@map("biology_panel_items")
}

// Lien biomarqueur ↔ besoin (1-12) / axe NeuroAxis / nutriment. PROVENANCE
// CLAIM OBLIGATOIRE (claim_id NOT NULL) : aucune association clinique ne naît
// d'une intuition. Reste VIDE jusqu'à CB-02b — et doit le rester visiblement.
// Cible polymorphe comme les plages : un ratio se lie à un besoin au même
// titre qu'un analyte (le HOMA vers la glycorégulation). L'unicité est portée
// par deux index PARTIELS créés dans la migration, et non par un `@@unique`
// ici : avec une colonne NULL, une unicité composée laisserait passer les
// doublons (sémantique Postgres).
model BiologyAnalyteLink {
  id           String   @id @default(cuid())
  analyteCode  String?  @map("analyte_code")
  ratioCode    String?  @map("ratio_code")
  cibleType    String   @map("cible_type")
  cibleCode    String   @map("cible_code")
  direction    String   @map("direction")
  claimId      String   @map("claim_id")
  versionClaim String   @map("version_claim")
  niveauPreuve String   @map("niveau_preuve")
  actif        Boolean  @default(true) @map("actif")
  createdAt    DateTime @default(now()) @map("created_at")

  analyte BiologyAnalyte? @relation(fields: [analyteCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  ratio   BiologyRatio?   @relation(fields: [ratioCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@index([cibleType, cibleCode], map: "biology_analyte_links_cible_idx")
  @@map("biology_analyte_links")
}

// Pointeur de version courante PAR SOURCE (patron C4) : on ne sert jamais
// toutes les versions de la nomenclature à la fois. L'import CB-02a déplace le
// pointeur dans la même transaction que l'insertion du nouveau millésime.
model BiologyCatalogVersionCourante {
  id               String   @id @default(cuid())
  sourceProvenance String   @unique @map("source_provenance")
  versionSource    String   @map("version_source")
  contenuSha256    String?  @map("contenu_sha256")
  nombreEntrees    Int      @default(0) @map("nombre_entrees")
  importeLe        DateTime @default(now()) @map("importe_le")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("biology_catalog_versions_courantes")
}

// Snapshot VERBATIM d'une source, par millésime — exigé par l'audit CB-00 §10,
// que CB-01 n'avait doté que d'une colonne d'empreinte : on conservait la
// preuve d'un contenu qu'on ne conservait pas.
//
// `contenu` est du TEXT et non du Json : `jsonb` réordonne les clés et
// normalise les nombres, si bien que les octets relus ne sont plus ceux qui
// ont été hachés et que l'empreinte n'atteste plus rien. En TEXT, un CHECK en
// base recalcule sha256 à chaque écriture. Le contenu reste interrogeable par
// un cast le jour où l'on retypera une propriété laissée de côté.
model BiologySourceSnapshot {
  id               String   @id @default(cuid())
  sourceProvenance String   @map("source_provenance")
  versionSource    String   @map("version_source")
  urlSource        String   @map("url_source")
  licence          String   @map("licence")
  contenu          String   @map("contenu")
  contenuSha256    String   @map("contenu_sha256")
  nombreConcepts   Int      @map("nombre_concepts")
  nombreActes      Int      @map("nombre_actes")
  importeLe        DateTime @default(now()) @map("importe_le")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([sourceProvenance, versionSource], map: "biology_source_snapshots_source_version_key")
  @@map("biology_source_snapshots")
}

// Arbitrage biologique SANS VALEURS (LOT-06, [[D-059]]) : au retour du bilan,
// le praticien confirme ou infirme une intention `conditionnelle_biologie`
// d'une version de protocole — un VERDICT et une note courte, JAMAIS une
// valeur d'analyse (verrou HDS ; les CHECK de la migration tiennent le
// verdict fermé et la note obligatoire sur `infirme`).
//
// `intentionId` est l'`actionId` de l'action au statut
// `conditionnelle_biologie` dans le payload du draft visé — la résolution de
// l'intention sans arbitrage lié est impossible par construction côté moteur.
// Append-only : un arbitrage ne se corrige pas ; la révision qu'il ouvre est
// une NOUVELLE version de protocole (`supersedesDraftId`), re-revue et
// re-approuvée avant diffusion. Un seul arbitrage par intention et par draft
// (`@@unique`) : arbitrer à nouveau se fait sur la version révisée.
// Table fille de `patients` : entre dans la transaction d'effacement IDP2
// (branchement dans la PR de code, après release de ce schéma).
model ArbitrageBiologique {
  id              String   @id @default(cuid())
  idPatient       String   @map("id_patient")
  protocolDraftId String   @map("protocol_draft_id")
  intentionId     String   @map("intention_id")
  verdict         String   @map("verdict") // confirme | infirme | sans_objet (CHECK migration)
  noteCourte      String?  @map("note_courte") // obligatoire si `infirme` (CHECK migration), bornée à 2000
  arbitreLe       DateTime @default(now()) @map("arbitre_le")
  arbitrePar      String   @map("arbitre_par") // email praticien, posé côté serveur
  createdAt       DateTime @default(now()) @map("created_at")

  patient Patient       @relation(fields: [idPatient], references: [idPatient])
  draft   ProtocolDraft @relation(fields: [protocolDraftId], references: [id])

  @@unique([protocolDraftId, intentionId], map: "cb_arbitrage_intention_unique")
  @@index([idPatient, arbitreLe], map: "cb_arbitrage_patient_idx")
  @@map("arbitrages_biologiques")
}

// LOT-06 — panel biologique DOCUMENTÉ HORS OUTIL, déclaré par le praticien.
//
// Le moteur de statuts distingue « jamais exploré » de « déjà documenté »
// (`deja_documente`, `a_repeter` — `statuts.ts`). Sans cette table, ces deux
// statuts sont INATTEIGNABLES et l'outil repropose un bilan que le patient
// vient de faire faire. C'est ce trou-là que la table ferme.
//
// SANS VALEURS (verrou HDS, comme `arbitrages_biologiques`) : l'outil connaît
// l'EXISTENCE et la DATE d'un bilan revenu sur papier, jamais un résultat.
// Aucune colonne de valeur ici — le contrat SQL négatif
// `cb_panels_documentes_v1_negatif.sql` le vérifie.
//
// UNE déclaration par panel et par patient (`@@unique`) : le moteur ne lit
// qu'une date par panel (`documentes.get(panelCode)`), et re-déclarer met la
// date à jour au lieu d'empiler une histoire que rien ne consomme.
//
// Table fille de `patients`, donc effacée par la transaction IDP2 DÈS CETTE
// PR : le banc de complétude d'`effacement.test.ts` se dérive du SCHÉMA, pas
// du code, et rougit à la seconde où le modèle apparaît. Le reporter à la PR
// de code n'est pas une option — `arbitrages_biologiques` l'a tenté (#680) et
// a dû revenir sur ses pas. Le coût est nommé : entre le déploiement Vercel
// de cette PR et l'approbation de `release-db`, un effacement de dossier
// échouerait sur une table absente. Il échoue FERMÉ (transaction annulée,
// rien de supprimé à moitié) et redevient possible après la release.
model PanelBiologieDocumente {
  id          String   @id @default(cuid())
  idPatient   String   @map("id_patient")
  panelCode   String   @map("panel_code")
  // Date du bilan hors outil. Le moteur en calcule un ÂGE en continu (pas un
  // jour civil) : la troncature à dix caractères de `statuts.ts` ne sert qu'au
  // motif affiché. Sans fuseau, une date saisie « 2026-08-01 » et sérialisée
  // en UTC peut basculer d'un jour — borné, un délai de répétition se comptant
  // en mois, mais à savoir avant d'écrire la route.
  documenteLe DateTime @map("documente_le")
  declarePar  String   @map("declare_par") // email praticien, posé côté serveur (CHECK migration : non vide)
  // `@updatedAt` : une re-déclaration REMET ce champ à l'instant courant sans
  // que l'appelant ait à y penser. `declarePar`, lui, n'a pas d'équivalent
  // automatique — le bloc `update` de l'upsert DOIT le réécrire, sinon la
  // ligne attribuera au premier déclarant une date posée par un second. Sur
  // une pièce de dossier relisible, ce serait une trace fausse.
  declareLe   DateTime @default(now()) @updatedAt @map("declare_le")
  createdAt   DateTime @default(now()) @map("created_at")

  patient Patient      @relation(fields: [idPatient], references: [idPatient])
  panel   BiologyPanel @relation(fields: [panelCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  // L'unicité commence par `idPatient` : elle sert aussi d'index pour la
  // lecture du dossier, qui filtre sur ce seul terme. Pas de second index.
  @@unique([idPatient, panelCode], map: "cb_panel_documente_unique")
  @@map("panels_biologie_documentes")
}

// Document patient du régime documentaire biologie (décision F du cadrage CB,
// CB-06 — [[D-122]]) : la trace écrite de ce qui a été PROPOSÉ au patient et
// pourquoi. La demande, JAMAIS le résultat — aucune colonne de valeur, le
// contrat SQL négatif fige la liste des colonnes (verrou « sans valeurs »,
// même régime que `panels_biologie_documentes`).
//
// Patron `CorrespondanceMedecin` ([[D-073]]), sans le médecin : texte généré
// côté serveur depuis la table d'indications SIGNÉE, ancrage de provenance en
// COLONNES (un SHA qu'une garde peut comparer, jamais une ancre en prose).
// Différence assumée avec le courrier : ici `ancrage_*` sont NON NULS — une
// correspondance saisie à la main n'a pas de source dérivable, ce document
// n'existe QUE dérivé de la table signée ; sans ancre, pas de ligne.
// Append-only : re-générer fait une ligne de plus, rien ne s'écrase.
// Table fille de `patients` : entre dans la transaction d'effacement IDP2
// DÈS CETTE PR (le banc de complétude dérive du schéma et rougit à la seconde
// où le modèle apparaît — précédent `arbitrages_biologiques`, #680).
model DocumentPatientBiologie {
  id             String   @id @default(cuid())
  idPatient      String   @map("id_patient")
  texte          String   @map("texte")
  ancrageSha256  String   @map("ancrage_sha256")
  ancrageVersion String   @map("ancrage_version")
  generePar      String   @map("genere_par") // email praticien, posé côté serveur (CHECK migration : non vide, ≤ 320)
  genereLe       DateTime @default(now()) @map("genere_le")
  createdAt      DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, genereLe], map: "cb_document_patient_patient_idx")
  @@map("documents_patient_biologie")
}

// Résultats biologiques réels du dossier (étage 2 du rayon, CB-09 —
// [[D-122]] §2) : la MESURE, par analyte seulement — pas de ratio en V1 (ils
// se calculent), entité distincte, jamais un champ de la proposition.
// `valeur` en numeric (exact — V1 quantitative seulement : un résultat
// qualitatif n'a pas de colonne, il attendra sa propre décision plutôt qu'un
// champ libre). `unite` porte le vocabulaire d'unités PARTAGÉ du catalogue :
// CHECK migration identique à `biology_analytes_unite_check` (« défini une
// fois, appliqué quatre fois » — l'égalité est tenue par le contrat),
// nullable comme lui — un analyte sans unité a des résultats sans unité,
// on n'en invente pas. `source`
// bornée par CHECK aux deux origines nommées par la décision. La borne
// « date non future » de `preleve_le` se garde côté route (`now()` interdit
// en CHECK). Table fille de `patients` : entre dans la transaction
// d'effacement IDP2 DÈS CETTE PR (le banc de complétude dérive du schéma —
// précédent `arbitrages_biologiques`, #680).
model ResultatBiologique {
  id          String   @id @default(cuid())
  idPatient   String   @map("id_patient")
  analyteCode String   @map("analyte_code")
  valeur      Decimal  @map("valeur")
  unite       String?  @map("unite")
  preleveLe   DateTime @map("preleve_le") // date de prélèvement : une DONNÉE, posée par le praticien
  source      String   @map("source") // saisie_praticien | import_labo (CHECK migration)
  saisiPar    String   @map("saisi_par") // email praticien, posé côté serveur (CHECK : non vide, ≤ 320)
  saisiLe     DateTime @default(now()) @map("saisi_le")
  createdAt   DateTime @default(now()) @map("created_at")

  // Correction d'une saisie ([[D-124]]) : append-only chaîné, patron
  // `supersedes_note_id` — corriger crée une LIGNE qui référence l'ancienne,
  // jamais un `update`. Référence SOUPLE, sans FK, comme les autres chaînes
  // `supersedes_*` ; la ligne visée est validée côté route.
  supersedesResultatId String? @map("supersedes_resultat_id")

  patient Patient        @relation(fields: [idPatient], references: [idPatient])
  analyte BiologyAnalyte @relation(fields: [analyteCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  // L'index commence par `idPatient` puis `analyteCode` : la lecture est la
  // série d'un analyte dans un dossier (estimé ↔ mesuré), avec une mesure par
  // analyte et date de prélèvement.
  //
  // L'UNICITÉ EST PARTIELLE et vit dans la migration seule — Prisma ne sait
  // pas exprimer un index partiel (même situation que
  // `biology_reference_ranges`) : `cb_resultat_bio_patient_analyte_idx`, qui
  // garde son nom d'origine, est UNIQUE sur (patient, analyte, date)
  // `WHERE supersedes_resultat_id IS NULL`. Une saisie NEUVE reste donc
  // soumise à l'unicité — le 409 `doublon_mesure` est un `P2002` et ne bouge
  // pas — pendant qu'une CORRECTION, qui porte un `supersedes` non nul, en
  // sort. Ne pas redéclarer ici un `@@unique` : il recréerait l'index TOTAL
  // et rendrait toute correction impossible. Ce commentaire N'EST PAS une
  // garde — c'est le contrat `cb_resultats_biologiques_v1_negatif.sql` qui
  // tient la régression, par sa forme d'index et par le cas de la fourche.
  //
  // `cb_resultat_bio_serie_idx` sert la lecture de la série ENTIÈRE,
  // corrections comprises — la garde partielle ne couvre que les têtes.
  @@index([idPatient, analyteCode, preleveLe], map: "cb_resultat_bio_serie_idx")
  @@index([supersedesResultatId], map: "cb_resultat_bio_supersedes_idx")
  @@map("resultats_biologiques")
}

// ───────────────────────────────────────────────────────────────────────────
// LE DOSSIER À DEUX VOIX (Alliance 6.0-A, LOT-01). Cinq tables ÉVÉNEMENT,
// append-only par convention (patron supersedes_note_id, aucune route
// d'update — bancs aux lots 02/03/04/06) : rien ne s'écrase, un correctif est
// une nouvelle ligne qui référence l'ancienne (dans l'esprit de DC-30 : une
// discordance reste visible — la règle elle-même vise les discordances entre
// sources ; ici c'est un arbitrage de campagne 6.0-A).
// DEUX DATES partout, jamais confondues (patron RelectureNote) : la
// date d'événement est une DONNÉE, nullable ; `cree_le` est posé par la BASE
// (@default(now())), jamais par l'appelant — inantidatable. Pas d'@updatedAt :
// une table événement n'a rien à remettre à jour.
//
// AUCUN CHAMP DE SCORE, SEUIL OU BANDE, nulle part (DC-19/DC-20 : aucun seuil
// inventé — la liste de DC-19 nomme explicitement les objectifs ; DC-27 garde
// la frontière score ≠ diagnostic). L'interdit est
// opposable par la LISTE BLANCHE de colonnes du contrat
// `prisma/checks/alli_dossier_deux_voix_v1_negatif.sql` — une colonne ajoutée
// sans passer par le contrat fait rougir le CI.
//
// Références de version (`supersedes_*`, `id_synthese`, `id_objectif`) :
// SOUPLES, sans FK (patron supersedes_note_id, schema historique ; l'unique
// FK auto-référente du dépôt a compliqué le restore HDS). Existence et
// appartenance au dossier se vérifient aux routes des lots suivants.
// ───────────────────────────────────────────────────────────────────────────

// L'objectif négocié : énoncé du patient, reformulation du praticien,
// priorité clinique, « non traité pour l'instant » assumé et daté. Chaque
// révision est une NOUVELLE ligne (supersedes_objectif_id) — la trajectoire
// de la négociation reste lisible en entier.
//
// `reformulation_praticien` est une COMPRÉHENSION, jamais une conclusion :
// aucun code diagnostique, aucune classification (DC-31, DC-32 — garde de
// forme aux lots de code). `priorite` est un LIBELLÉ LIBRE praticien — jamais
// un rang calculable ni un score (DC-19/DC-20) : le jour où quelqu'un veut le
// trier, c'est la doctrine qu'il faut rouvrir, pas une colonne à typer.
model ObjectifNegocie {
  id                      String    @id @default(cuid()) @map("id")
  idPatient               String    @map("id_patient")
  praticienEmail          String    @map("praticien_email")
  enoncePatient           String    @map("enonce_patient")
  reformulationPraticien  String?   @map("reformulation_praticien")
  priorite                String?   @map("priorite")
  nonTraiteMotif          String?   @map("non_traite_motif")
  nonTraiteDepuisLe       DateTime? @map("non_traite_depuis_le")
  supersedesObjectifId    String?   @map("supersedes_objectif_id")
  // 6.0-B (D-094) : la proposition dont cet objectif est la REPRISE, si
  // c'en est une. Référence souple (patron supersedes_objectif_id), NULLE
  // pour tout objectif rédigé de la main du praticien — l'immense majorité
  // à ce jour, et jamais un défaut à combler.
  sourcePropositionId     String?   @map("source_proposition_id")
  negocieLe               DateTime? @map("negocie_le")
  creeLe                  DateTime  @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "alli_objectif_negocie_patient_idx")
  @@map("objectifs_negocies")
}

// « Ce qui compte pour moi aujourd'hui » : entrée libre du patient, déposée
// au portail, CONSERVÉE — la trajectoire de sens à côté des scores, jamais
// résumée dans un score (DC-19/DC-20). Une entrée absente est un SILENCE, pas une
// réponse (DC-24) — c'est l'affichage qui porte la distinction, pas une ligne
// fabriquée.
//
// `saisi_le` est déclaré par le client (le moment où le patient dit
// « aujourd'hui ») : sans fuseau, un jour civil sérialisé UTC peut basculer
// d'un jour (précédent PanelBiologieDocumente.documenteLe) — la route du
// LOT-03 borne cette déclaration ; la base, elle, date l'enregistrement.
// Pas de `praticien_email` : c'est une parole de patient.
model EntreeCeQuiCompte {
  id        String    @id @default(cuid()) @map("id")
  idPatient String    @map("id_patient")
  texte     String    @map("texte")
  saisiLe   DateTime? @map("saisi_le")
  creeLe    DateTime  @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "alli_ce_qui_compte_patient_idx")
  @@map("ce_qui_compte_entrees")
}

// « Ce que j'ai compris de vous » : synthèse de compréhension rédigée par le
// praticien, versionnée. LIGNES IMMUABLES : publier un brouillon n'est PAS un
// update — c'est une nouvelle ligne (supersedes_synthese_id) dont
// `publiee_le` est renseignée À L'INSERT. Une ligne à `publiee_le` NULL est
// un brouillon praticien ; aucune surface patient ne la lit (garde aux lots
// 04/06).
model SyntheseComprehension {
  id                   String    @id @default(cuid()) @map("id")
  idPatient            String    @map("id_patient")
  praticienEmail       String    @map("praticien_email")
  texte                String    @map("texte")
  redigeeLe            DateTime? @map("redigee_le")
  publieeLe            DateTime? @map("publiee_le")
  supersedesSyntheseId String?   @map("supersedes_synthese_id")
  creeLe               DateTime  @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "alli_synthese_comprehension_patient_idx")
  @@map("syntheses_comprehension")
}

// « Ce n'est pas exactement ça » : désaccord structuré du patient sur UNE
// version précise de synthèse. Un désaccord se SIGNALE, reste visible, ne
// s'écrase et ne se moyenne jamais (dans l'esprit de DC-30, qui vise les
// discordances entre sources — ici, arbitrage de campagne) ; il n'a pas
// d'état « supprimé ».
//
// `id_synthese` : NOT NULL — un désaccord orphelin ne conteste rien — mais
// référence SOUPLE (patron CorrespondanceMedecin.id_synthese) : la route du
// LOT-04 vérifie existence et appartenance au POST, et l'effacement du
// dossier emporte les deux tables dans la même transaction.
//
// PAS de colonne d'accusé de lecture praticien : une colonne mutable
// contredirait l'append-only. Sa représentation (nouvelle version de
// synthèse, journal, autre) appartient au LOT-04 — dette nommée au fichier
// de lot.
model DesaccordComprehension {
  id         String    @id @default(cuid()) @map("id")
  idPatient  String    @map("id_patient")
  idSynthese String    @map("id_synthese")
  texte      String?   @map("texte")
  exprimeLe  DateTime? @map("exprime_le")
  creeLe     DateTime  @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "alli_desaccord_patient_idx")
  @@map("desaccords_comprehension")
}

// La ratification : le geste du patient sur UNE version précise d'objectif —
// « ratifie » ou « conteste » (CHECK migration : taxonomie de GESTE, deux
// valeurs, aucune sémantique clinique). Un changement d'avis est une NOUVELLE
// ligne : une ratification ne se retire pas, elle se succède (dans l'esprit
// de DC-30 — arbitrage de campagne).
// Consommée au LOT-06 (écran portail) ; le gate de campagne — la ratification
// patient précède l'activation élargie protocole→produits — se constate sur
// cette table.
model RatificationObjectif {
  id         String    @id @default(cuid()) @map("id")
  idPatient  String    @map("id_patient")
  idObjectif String    @map("id_objectif")
  sens       String    @map("sens") // ratifie | conteste (CHECK migration)
  gesteLe    DateTime? @map("geste_le")
  creeLe     DateTime  @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "alli_ratification_patient_idx")
  @@map("ratifications_objectif")
}

// ─────────────────────────────────────────────────────────────────────────
// ALLIANCE 6.0-B — L'OBJECTIF À TROIS VOIX (D-094)
//
// « La machine cite, elle n'invente pas. » Deux tables événement, mêmes
// invariants que 6.0-A : append-only, deux dates, aucune colonne de score.
// ─────────────────────────────────────────────────────────────────────────

// La PROPOSITION d'objectif : un assemblage de fragments qui portent chacun
// leur provenance (D-094, liste fermée à trois sources — anamnèse verbatim,
// restitution d'instrument certifié, règle signée). `fragments` est un JSONB
// de `{texte, source}` — et sa FORME n'est gardée NULLE PART à ce jour : le
// contrat n'éprouve que « tableau non vide », le module qui portera
// l'invariant « aucun fragment sans source » est celui du LOT-02. Dette
// nommée, pas couverture acquise (détail : en-tête de la migration).
//
// `hash_sources` porte la CADUCITÉ (patron proposalHash du cockpit) : les
// données sources ayant bougé, la proposition ne se sert plus et ne se
// reprend plus. Elle n'est pas effacée pour autant — on ne réécrit pas
// l'histoire d'un dossier.
//
// PAS DE RANG, PAS DE SCORE, PAS DE NUMÉRO D'ORDRE : D-094 §3 interdit
// jusqu'à la numérotation — l'ordre des candidats n'est couvert par aucune
// ligne signée (D-093), il ne doit pas se lire comme un classement. L'ordre
// d'affichage se décide au rendu, il ne se persiste jamais.
model PropositionObjectif {
  id           String    @id @default(cuid()) @map("id")
  idPatient    String    @map("id_patient")
  fragments    Json      @map("fragments")
  hashSources  String    @map("hash_sources")
  assembleeLe  DateTime? @map("assemblee_le")
  creeLe       DateTime  @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "alli_proposition_objectif_patient_idx")
  @@map("propositions_objectif")
}

// Ce que le praticien FAIT d'une proposition — événement, jamais un update
// sur la proposition elle-même : `reprise` (elle devient un objectif
// négocié, lequel la référence par `source_proposition_id`) ou `ecartee`
// (avec motif obligatoire, CHECK migration).
//
// L'ÉCART MOTIVÉ EST LE MATÉRIAU DU LOT-06 : c'est lui qui dira si le
// classement des candidats mérite d'être signé (D-093). Une proposition
// écartée sans raison ne dit rien ; c'est pourquoi le motif n'est pas
// nullable.
//
// `caduque` n'est PAS un geste et n'a pas sa ligne ici : la caducité se
// DÉRIVE de `hash_sources` — personne ne l'a décidée.
model DispositionProposition {
  id             String    @id @default(cuid()) @map("id")
  idPatient      String    @map("id_patient")
  idProposition  String    @map("id_proposition")
  praticienEmail String    @map("praticien_email")
  geste          String    @map("geste") // reprise | ecartee (CHECK migration)
  motif          String?   @map("motif")
  disposeLe      DateTime? @map("dispose_le")
  creeLe         DateTime  @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "alli_disposition_proposition_patient_idx")
  @@map("dispositions_proposition")
}

// L'AMENDEMENT du patient — « le dire autrement » (D-094 §2). TABLE PROPRE
// et non un `sens` de plus sur `ratifications_objectif` : un amendement
// porte un TEXTE, une ratification n'en porte pas ; les fusionner
// affaiblirait les deux objets.
//
// Même régime que la ratification : écrivain unique au portail, référence à
// la version EXACTE de l'objectif (`id_objectif`, souple sans FK),
// append-only — se raviser se dit en le disant, une ligne de plus. Le texte
// est NOT NULL et non vide : un amendement sans mots n'est pas un
// amendement, c'est une contestation — et celle-là existe déjà.
//
// Pas de `praticien_email` : c'est une parole de patient.
model AmendementObjectif {
  id         String    @id @default(cuid()) @map("id")
  idPatient  String    @map("id_patient")
  idObjectif String    @map("id_objectif")
  texte      String    @map("texte")
  exprimeLe  DateTime? @map("exprime_le")
  creeLe     DateTime  @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "alli_amendement_objectif_patient_idx")
  @@map("amendements_objectif")
}

// LA RÉPONSE D'ÉTAPE (Alliance 6.0-B, LOT-05) — où le patient en est PAR
// RAPPORT À SON OBJECTIF, aux jalons J21/J42/J90.
//
// TABLE PROPRE, et non un élargissement de `protocol_checkins` : celle-là est
// ancrée à un PROTOCOLE (`protocol_draft_id` et `id_assignation` NOT NULL) et
// parle en J7/J14/J21. Une réponse d'étape sur un objectif n'a ni protocole ni
// assignation, et sa taxonomie de jalon est celle de `JOURS_JALON`
// (`equilibre/constants.ts`) — les fusionner rendrait la table bilingue sur ses
// deux axes. Même raisonnement que `D-094` §2 pour l'amendement.
//
// `id_objectif` PORTE LA VERSION EXACTE, référence souple sans FK (patron de
// toute la campagne) : le patient dit où il en est par rapport au texte qu'on
// lui a servi, pas par rapport à « son objectif » en général. Sans cet ancrage,
// une reformulation ultérieure ferait porter sa réponse sur des mots qu'il n'a
// jamais lus.
//
// `texte` NOT NULL non vide : une réponse d'étape sans mots n'est pas une
// réponse. `eva` est FACULTATIVE et RESTITUÉE BRUTE — aucune bande, aucun
// seuil, aucune moyenne, aucune courbe (`D-088`, `DC-19`/`DC-20`). Ses bornes
// 0-10 sont TECHNIQUES, ce que le CHECK de migration dit en toutes lettres.
//
// PAS DE praticien_email : c'est une parole de patient. `repondu_le` reste la
// colonne de DÉCLARATION du patron de campagne (comme `exprime_le` et
// `geste_le`), nulle tant que personne ne déclare de date.
model ReponseJalonObjectif {
  id         String    @id @default(cuid()) @map("id")
  idPatient  String    @map("id_patient")
  idObjectif String    @map("id_objectif")
  jalon      String    @map("jalon") // J21 | J42 | J90 (CHECK migration)
  texte      String    @map("texte")
  eva        Int?      @map("eva") // 0-10, borne TECHNIQUE (CHECK migration)
  reponduLe  DateTime? @map("repondu_le")
  creeLe     DateTime  @default(now()) @map("cree_le")

  patient Patient @relation(fields: [idPatient], references: [idPatient])

  @@index([idPatient, creeLe], map: "alli_reponse_jalon_patient_idx")
  @@map("reponses_jalon_objectif")
}
